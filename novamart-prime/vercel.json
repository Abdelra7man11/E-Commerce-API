{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://novamart-api.runasp.net/api/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "http://novamart-api.runasp.net/images/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
